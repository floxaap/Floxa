rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return request.auth.uid; }
    match /users/{uid} { allow read: if request.auth != null;
      allow create: if me() == uid && request.resource.data.verified == false;
      allow update: if me() == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified','username','followersCount','followingCount'])
        && request.resource.data.get('bio', '').size() <= 160 && request.resource.data.name.size() <= 50;
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
        && math.abs(request.resource.data.followersCount - resource.data.get('followersCount', 0)) <= 1;
      allow update: if me() == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount'])
        && math.abs(request.resource.data.followingCount - resource.data.get('followingCount', 0)) <= 1;
      allow delete: if me() == uid;
      match /saved/{pid} { allow read, write: if me() == uid; } }
    match /usernames/{name} { allow read: if true; allow create: if request.auth != null && request.resource.data.uid == me();
      allow delete: if request.auth != null && resource.data.uid == me(); }
    match /posts/{id} {
      allow read: if request.auth != null;
      allow create: if me() == request.resource.data.authorId && request.resource.data.likeCount == 0 && request.resource.data.commentCount == 0 && request.resource.data.caption.size() <= 2000;
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount','commentCount'])
        && math.abs(request.resource.data.likeCount - resource.data.likeCount) <= 1
        && math.abs(request.resource.data.commentCount - resource.data.commentCount) <= 1;
      allow delete: if me() == resource.data.authorId;
      match /comments/{cid} { allow read: if request.auth != null;
        allow create: if me() == request.resource.data.authorId && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow delete: if me() == resource.data.authorId; }
      match /likes/{uid} { allow read: if request.auth != null; allow create, delete: if me() == uid; }
    }
    match /conversations/{cid} {
      function member() { return request.auth.uid in resource.data.members; }
      allow get: if resource == null || member();
      allow list: if member();
      allow create: if request.auth.uid in request.resource.data.members && request.resource.data.get('isGroup', false) == false && request.resource.data.members.size() == 2
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow create: if request.resource.data.isGroup == true && request.resource.data.ownerId == me() && me() in request.resource.data.members
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 50 && request.resource.data.admins == [me()]
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow update: if me() in resource.data.get('admins', []) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins','memberInfo','name','description'])
        && request.resource.data.members.size() <= 50 && request.resource.data.name.size() <= 60 && request.resource.data.members.hasAll(request.resource.data.admins);
      allow update: if member() && resource.data.get('isGroup', false) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins','memberInfo'])
        && request.resource.data.members.size() == resource.data.members.size() - 1 && !(me() in request.resource.data.members) && resource.data.members.hasAll(request.resource.data.members)
        && (me() in resource.data.admins || resource.data.admins.hasAll(request.resource.data.admins));
      allow update: if member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastAt','unread']);
      match /messages/{mid} {
        function inConv() { return request.auth.uid in get(/databases/$(db)/documents/conversations/$(cid)).data.members; }
        allow read: if inConv();
        allow create: if inConv() && request.resource.data.senderId == me() && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000;
        allow update: if inConv() && ((me() == resource.data.senderId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt','deleted']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy','deliveredTo']));
      }
    }
    match /follows/{fid} { allow read: if request.auth != null;
      allow create: if me() == request.resource.data.followerId && fid == me() + '_' + request.resource.data.followedId && request.resource.data.followedId != me();
      allow delete: if me() == resource.data.followerId; }
    match /notifications/{nid} {
      allow read: if me() == resource.data.toUid;
      allow create: if me() == request.resource.data.fromUid && request.resource.data.toUid != me() && request.resource.data.read == false;
      allow update: if me() == resource.data.toUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']); }
    match /calls/{id} {
      function party() { return me() == resource.data.callerId || me() == resource.data.calleeId; }
      allow read: if party();
      allow create: if me() == request.resource.data.callerId && request.resource.data.status == 'ringing' && request.resource.data.calleeId != me();
      allow update: if (me() == resource.data.callerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt']) && request.resource.data.status in ['missed','ended'])
        || (me() == resource.data.calleeId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status','answeredAt','endedAt']) && request.resource.data.status in ['accepted','declined','ended']);
      match /callerCandidates/{c} { allow read: if me() in [get(/databases/$(db)/documents/calls/$(id)).data.callerId, get(/databases/$(db)/documents/calls/$(id)).data.calleeId]; allow create: if me() == get(/databases/$(db)/documents/calls/$(id)).data.callerId; }
      match /calleeCandidates/{c} { allow read: if me() in [get(/databases/$(db)/documents/calls/$(id)).data.callerId, get(/databases/$(db)/documents/calls/$(id)).data.calleeId]; allow create: if me() == get(/databases/$(db)/documents/calls/$(id)).data.calleeId; }
    }
    match /reports/{rid} { allow create: if request.auth != null && me() == request.resource.data.reporterId; }
    match /stories/{id} { allow read: if request.auth != null; allow create: if me() == request.resource.data.authorId; allow delete: if me() == resource.data.authorId; }
  }
}
